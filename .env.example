# One LLM key enables the language-model planner and MeSH proposer (both optional:
# without a key the rule-based planner and the registry-grounded resolver are used).
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ClinicalTrials.gov client
# CTGOV_CACHE_DIR=.cache/ctgov
# CTGOV_CACHE_TTL=86400
# CTGOV_OFFLINE=0          # 1 = serve only cached responses (replay), never call the network
# LOG_LEVEL=INFO
